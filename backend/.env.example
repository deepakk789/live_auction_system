# ─────────────────────────────────────────────
# AuctionX Backend — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/auctionx?retryWrites=true&w=majority

# JWT — use a long random string (min 32 characters)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string_here

# Frontend URL — for CORS (no trailing slash)
FRONTEND_URL=http://localhost:5173

# Nodemailer — Gmail SMTP for password reset emails
# IMPORTANT: Use port 587 (STARTTLS) — Render.com blocks port 465 (SSL)
# Use a Gmail App Password (NOT your real password)
# Guide: https://support.google.com/accounts/answer/185833
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password_here
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# ─────────────────────────────────────────────
# Render.com deployment (Environment tab — NOT .env file)
# Render does not read .env from git. Add each variable in the dashboard:
#
#   PORT=10000                    (Render sets this automatically)
#   NODE_ENV=production
#   MONGO_URI=mongodb+srv://...
#   JWT_SECRET=<long-random-string>
#   FRONTEND_URL=https://your-frontend.vercel.app
#   EMAIL_USER=your@gmail.com
#   EMAIL_PASS=<16-char-gmail-app-password>
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#
# Gmail: enable 2FA, then create App Password at
# https://myaccount.google.com/apppasswords
# Use port 587 only — Render blocks port 465 (SSL).
# ─────────────────────────────────────────────
